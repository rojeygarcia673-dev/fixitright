# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used by the seed/admin script (NEVER expose to the browser,
# never commit the real value). Optional — only needed for scripted seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
